          "mode": "raw",
          "raw": "{\n  \"isuId\": {{student_isu}},\n  \"fullName\": \"Иванов Иван Иванович\",\n  \"group\": \"M3301\",\n  \"dormitory\": 8,\n  \"room\": 101,\n  \"settlementDate\": \"2026-09-01\",\n  \"isForeigner\": false,\n  \"notes\": \"\"\n}",
