    {
      "name": "15 Refresh rotation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/refresh",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "pm.environment.set(\"old_refresh_token\", pm.environment.get(\"refresh_token\"));",
              "if (pm.response.code === 200) { const t = pm.response.json(); pm.environment.set(\"access_token\", t.accessToken); pm.environment.set(\"refresh_token\", t.refreshToken); }"
            ]
          }
        }
      ]
    },
